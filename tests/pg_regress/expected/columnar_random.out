BEGIN;
DECLARE curh SCROLL CURSOR FOR SELECT * FROM lzh WHERE host = 'h3' ORDER BY host, ts DESC;
FETCH ABSOLUTE 100 FROM curh;
              ts              | host |         a          | b |                c                 
