INSERT INTO r_ticks SELECT g, g % 10 FROM generate_series(0, 4999) g;
CALL snouttime.migrate('r_ticks');
SELECT snouttime.create_rollup('r_tick_sums', 'r_ticks', bucket_width => 100, select_list => 'sum(v) AS s');
